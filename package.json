{
  "name": "ringcentral-js-widgets",
  "version": "0.16.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "crius/packages/*",
    "next/*"
  ],
  "scripts": {
    "setup": "echo \"Error: no setup specified\" && exit 0",
    "start": "yarn workspace @ringcentral-integration/widgets-demo start",
    "release": "yarn workspace @ringcentral-integration/widgets release && yarn workspace @ringcentral-integration/commons release",
    "commons:test": "yarn workspace @ringcentral-integration/commons test",
    "docs": "yarn workspace ringcentral-widgets-docs start",
    "docs:build": "yarn workspace ringcentral-widgets-docs build",
    "lockfile:fix": "node scripts/lockfile-integrity.mjs fix",
    "lockfile:check": "node scripts/lockfile-integrity.mjs check",
    "publish-packages": "node scripts/publishPackages.mjs",
    "commit": "yarn git-cz"
  },
  "devDependencies": {
    "@rc-ex/debug": "1.2.3",
    "@ringcentral-integration/babel-settings": "*",
    "@ringcentral/spring-theme": "^1.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/inquirer": "^6.5.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/through2": "^2.0.41",
    "@types/uuid": "^10.0.0",
    "commitizen": "^4.3.1",
    "core-js": "^3.9.1",
    "cz-conventional-changelog": "^2.1.0",
    "eslint-settings": "*",
    "observable-hooks": "^4.2.1",
    "postcss": "^8.4.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router": "^5.3.1",
    "react-router-dom": "^5.3.1",
    "reactant-share": "^0.150.0",
    "reactant-web": "^0.150.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "serialize-error": "^7.0.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "fs-extra": "^10.1.0"
  }
}
