    "@ringcentral-integration/next-integration": "*",
    "@ringcentral-integration/next-widgets": "*",
    "@ringcentral-integration/utils": "*",
    "@ringcentral-integration/widgets": "*",
    "@ringcentral/juno": "^2.42.0",
    "@ringcentral/juno-icon": "^1.80.0",
    "ramda": "^0.28.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
