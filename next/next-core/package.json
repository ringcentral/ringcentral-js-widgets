  },
  "dependencies": {
    "@ringcentral/mfe-logger": "^0.5.0",
    "@ringcentral/mfe-react": "^0.5.0",
    "@ringcentral-integration/utils": "*",
    "data-transport": "^5.0.3",
    "reactant-share": "^0.150.0",
    "reactant": "^0.150.0",
    "reactant-last-action": "^0.150.0",
    "reactant-web": "^0.150.0",
    "reactant-router": "^0.150.0",
    "localforage": "^1.10.0",
    "react-router-dom": "^5.3.1",
    "ramda": "^0.28.0",
    "rxjs": "^7.8.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ringcentral-integration/test-utils": "*",
    "@types/react-router-dom": "^5.3.3"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0",
    "react-dom": "^17.0.2 || ^18.0.0"
  },
  "common": true,
