{
  "$schema": "../../libs/next-builder/src/projectConfigSchema.json",
  "distPath": "dist",
  "buildPath": "build",
  "themePath": "src",
  "pages": [
    {
      "index": "src/host.html",
      "main": "src/host.ts"
    },
    {
      "index": "src/index.html",
      "main": "src/main.ts"
    },
    {
      "index": "pages/proxy/proxy.html",
      "main": "pages/proxy/proxy.ts"
    },
    {
      "index": "pages/redirect/redirect.html",
      "main": "pages/redirect/redirect.ts"
    }
  ],
  "assets": ["src/assets", "src/icon.svg"],
  "environment": {
    "local": {
      "brand": ["rc", "bt", "att", "telus"],
      "mode": "development"
    },
    "dev": {
      "brand": ["rc", "bt", "att", "telus"],
      "mode": "production"
    },
    "reg": {
      "brand": ["rc", "bt", "att", "telus"],
      "mode": "production"
    },
    "prod": {
      "brand": ["rc", "bt", "att", "telus"],
      "mode": "production"
    }
  },
  "appConfigPath": "config/index.ts",
  "devServerPort": 8081,
  "themeSystem": "spring-ui",
  "includeUpgradePage": true,
  "includeHiddenDownloadPage": true
}
