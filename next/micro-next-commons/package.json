{
  "name": "@ringcentral-integration/micro-next-commons",
  "version": "0.0.1",
  "description": "Common libraries and re-exports for RingCentral Integration micro-frontend modules.",
  "homepage": "https://github.com/ringcentral/ringcentral-js-widgets/tree/master/next/micro-next-commons#readme",
  "bugs": {
    "url": "https://github.com/ringcentral/ringcentral-js-widgets/issues"
  },
