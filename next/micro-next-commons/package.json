  },
  "license": "MIT",
  "author": "RingCentral Integration Team",
  "main": "src/app/index.js",
  "scripts": {
    "build-spa": "yarn gulp build --env spa",
    "build": "yarn gulp build --env mfe",
    "lib-build": "yarn gulp libBuild",
    "release": "yarn gulp release",
    "serve": "http-server build/25.3.10/rc --cors -S -p 8091",
