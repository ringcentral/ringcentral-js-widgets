    "@ringcentral-integration/next-builder": "*",
    "@ringcentral-integration/test-utils": "*",
    "fs-extra": "^10.1.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-sourcemaps": "^2.6.5",
    "webpack": "^5.89.0",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-dev-server": "^4.15.1"
