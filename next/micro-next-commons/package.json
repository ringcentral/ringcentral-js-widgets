    "tsc-check": "yarn tsc --project tsconfig.lint.json --noEmit"
  },
  "dependencies": {
    "@ringcentral/mfe-react": "^0.4.18",
    "@ringcentral-integration/next-micro": "*",
    "@ringcentral-integration/commons": "*",
    "@ringcentral-integration/i18n": "*",
    "@ringcentral-integration/micro-core": "*",
    "@ringcentral-integration/micro-auth": "*",
    "@ringcentral-integration/micro-contacts": "*",
    "@ringcentral-integration/micro-coworker": "*",
    "@ringcentral-integration/micro-meeting": "*",
    "@ringcentral-integration/micro-message": "*",
    "@ringcentral-integration/micro-phone": "*",
    "@ringcentral-integration/micro-setting": "*",
    "@ringcentral-integration/next-core": "*",
    "@ringcentral-integration/next-integration": "*",
    "@ringcentral-integration/next-widgets": "*",
    "@ringcentral-integration/utils": "*",
    "@ringcentral-integration/widgets": "*",
    "@ringcentral/juno": "^2.42.0",
    "@ringcentral/juno-icon": "^1.80.0",
